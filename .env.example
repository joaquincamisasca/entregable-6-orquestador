# Proveedor del LLM usado por el Supervisor y ambos especialistas.
# "ollama" (default, 100% gratis y local, requiere tener Ollama
# instalado y corriendo con un modelo que soporte tool calling y salida
# estructurada — ver README.md), "anthropic" u "openai" (requieren key y
# crédito cargado).
GENERATION_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Solo necesarias si GENERATION_PROVIDER=openai
OPENAI_API_KEY=sk-tu-api-key-de-openai-aca
OPENAI_MODEL=gpt-4o

# Solo necesaria si GENERATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=tu-api-key-de-anthropic-aca
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Techo de vueltas del Supervisor por invocación, para evitar el
# "Supervisor Infinito"
MAX_PASOS_SUPERVISOR=6
